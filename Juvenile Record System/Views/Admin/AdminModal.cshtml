@model User

@{
    string actionType = ViewBag.ActionType as string;

    // Helper logic for initials (used in details view)
    string initials = "U";
    if (!string.IsNullOrEmpty(Model?.FullName))
    {
        var nameParts = Model.FullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length >= 2)
        {
            initials = $"{nameParts[0][0]}{nameParts[nameParts.Length - 1][0]}".ToUpper();
        }
        else if (nameParts.Length == 1)
        {
            initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
        }
    }
}

<!-- Assign Role Modal -->
@if (actionType == "assignRole")
{
    var selectedPermits = ViewBag.SelectedPermits as string[] ?? new string[0];
    Func<string, IHtmlString> checkedAttr = m =>
        selectedPermits.Contains(m, StringComparer.OrdinalIgnoreCase)
            ? new HtmlString(" checked=\"checked\"")
            : new HtmlString(string.Empty);

    using (Html.BeginForm("AssignRole", "Admin", FormMethod.Post, new { id = "adminModalForm" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />

        <!-- Officer Profile Header Card -->
        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border mb-4">
            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width: 48px; height: 48px;">
                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h6 class="mb-0 fw-bold text-dark">@Model.FullName</h6>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle font-monospace small">
                        @(string.IsNullOrEmpty(Model.FormattedUserId) ? "U-" + Model.UserId : Model.FormattedUserId)
                    </span>
                    <span class="text-muted small">• @Model.Username</span>
                </div>
            </div>
        </div>

        <!-- Role Assignment Selection -->
        <div class="mb-4">
            <label for="rolePermitSelect" class="form-label fw-bold text-dark small">Assign Role / Permit Level</label>

            @Html.DropDownListFor(
                m => m.RoleId,
                (SelectList)ViewBag.AvailableRoles,
                "-- Select Role / Permit --",
                new { @class = "form-select shadow-none py-2", @id = "rolePermitSelect", @required = "required" }
            )

            <div class="form-text small text-muted">Select the administrative permission level for this officer account.</div>
        </div>

        <!-- Module Access Checkboxes -->
        <div class="mb-4" id="permitCheckboxesWrapper" data-saved-permits="@string.Join(",", selectedPermits)">
            <label class="form-label fw-bold text-dark small d-block mb-2">Checkpoint &amp; System Module Permits</label>
            <div class="p-3 bg-light rounded-3 border">
                <div class="row g-2">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input permit-checkbox enforcement-default" type="checkbox" name="selectedPermits" value="ScanBiometrics" id="permitScan" @checkedAttr("ScanBiometrics") />
                                <label class="form-check-label small fw-medium text-dark" for="permitScan">
                                    Scan Face ID &amp; Biometrics <span class="badge bg-secondary-subtle text-secondary border ms-1 checkpoint-lock-badge d-none">Restricted</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input permit-checkbox enforcement-default" type="checkbox" name="selectedPermits" value="Authenticate" id="permitAuth" @checkedAttr("Authenticate") />
                                <label class="form-check-label small fw-medium text-dark" for="permitAuth">
                                    Authenticate Offender <span class="badge bg-secondary-subtle text-secondary border ms-1 checkpoint-lock-badge d-none">Restricted</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input permit-checkbox enforcement-default" type="checkbox" name="selectedPermits" value="CheckRecords" id="permitCheck" @checkedAttr("CheckRecords") />
                                <label class="form-check-label small fw-medium text-dark" for="permitCheck">
                                    Check Offender Records <span class="badge bg-secondary-subtle text-secondary border ms-1 checkpoint-lock-badge d-none">Restricted</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input permit-checkbox enforcement-default" type="checkbox" name="selectedPermits" value="ManageProfile" id="permitManage" @checkedAttr("ManageProfile") />
                                <label class="form-check-label small fw-medium text-dark" for="permitManage">
                                    Manage Offender Profile <span class="badge bg-secondary-subtle text-secondary border ms-1 checkpoint-lock-badge d-none">Restricted</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input permit-checkbox restricted-module" type="checkbox" name="selectedPermits" value="ProcessPenalty" id="permitPenalty" @checkedAttr("ProcessPenalty") />
                                <label class="form-check-label small fw-medium text-dark" for="permitPenalty">
                                    Process Penalty <span class="badge bg-secondary-subtle text-secondary border ms-1 review-lock-badge" id="penaltyLockBadge">Restricted</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input permit-checkbox restricted-module" type="checkbox" name="selectedPermits" value="JuvenileRecords" id="permitJuveniles" @checkedAttr("JuvenileRecords") />
                                <label class="form-check-label small fw-medium text-dark" for="permitJuveniles">
                                    Juvenile Records <span class="badge bg-secondary-subtle text-secondary border ms-1 review-lock-badge" id="juvenileLockBadge">Restricted</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-text small text-muted mt-2 mb-0" id="permitHelperNote">
                    Enforcement Officer locks Process Penalty and Juvenile Records while unlocking standard checkpoint modules.
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <button type="button" class="btn btn-light px-4 border rounded-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-dark px-4 rounded-2 fw-semibold">Save Changes</button>
        </div>
    }
}
else if (actionType == "details")
{
    var officerPermits = ViewBag.OfficerPermits as string[] ?? new string[0];
    bool isAdminPermits = officerPermits.Length == 1 &&
                          string.Equals(officerPermits[0], "All Modules (Admin)", StringComparison.OrdinalIgnoreCase);

    string displayName = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim() : Model.Username;
    initials = "U";
    if (!string.IsNullOrWhiteSpace(displayName))
    {
        var parts = displayName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length >= 2
            ? (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper()
            : parts[0].Substring(0, 1).ToUpper();
    }

    var selectedPermits = ViewBag.SelectedPermits as string[] ?? new string[0];
    Func<string, bool> isChecked = m => selectedPermits.Contains(m, StringComparer.OrdinalIgnoreCase);

    <!-- DETAILS VIEW MODE -->
    <div class="px-2">
        <!-- Officer Profile Header Card -->
        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border mb-4">
            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width: 56px; height: 56px; font-size: 1.25rem; letter-spacing: 0.5px;">
                @initials
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-1 fs-5">@Model.FullName</h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle font-monospace small">
                        @Model.FormattedUserId
                    </span>
                    <span class="text-muted small">• @@@Model.Username</span>
                    @if (Model.Role != null && !string.IsNullOrWhiteSpace(Model.Role.RoleName))
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                            @Model.Role.RoleName
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Structured Details Grid -->
        <div class="row g-3 text-start mb-2">
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Account Status</span>
                    <div>
                        @if (string.Equals(Model.AccountStatus, "Active", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Inactive</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Officer ID</span>
                    <span class="fw-bold text-dark font-monospace">@Model.FormattedUserId</span>
                </div>
            </div>

            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Email Address</span>
                    <span class="text-dark fw-medium">@(string.IsNullOrWhiteSpace(Model.Email) ? "Not specified" : Model.Email)</span>
                </div>
            </div>

            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Phone Number</span>
                    <span class="text-dark fw-medium">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not specified" : Model.PhoneNumber)</span>
                </div>
            </div>

            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Birthdate</span>
                    <span class="text-dark fw-medium">@(Model.Birthdate.HasValue ? Model.Birthdate.Value.ToString("MMMM dd, yyyy") : "Not specified")</span>
                </div>
            </div>

            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Registered Date</span>
                    <span class="text-dark fw-medium">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</span>
                </div>
            </div>

            <div class="col-12">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Home Address</span>
                    <span class="text-dark fw-medium">@(string.IsNullOrWhiteSpace(Model.HomeAddress) ? "Not specified" : Model.HomeAddress)</span>
                </div>
            </div>

            <div class="col-12">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-secondary small text-uppercase fw-semibold d-block mb-2">Module Permits</span>

                    @if (isAdminPermits)
                    {
                        <span class="badge bg-dark text-white px-3 py-1 rounded-pill">All Modules (Admin)</span>
                    }
                    else if (officerPermits.Length == 0)
                    {
                        <span class="text-muted small fst-italic">No modules permitted</span>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var permit in officerPermits)
                            {
                                bool isRestricted = string.Equals(permit, "ProcessPenalty", StringComparison.OrdinalIgnoreCase) ||
                                                    string.Equals(permit, "JuvenileRecords", StringComparison.OrdinalIgnoreCase);

                                <span class="badge @(isRestricted ? "bg-warning-subtle text-dark border border-warning-subtle" : "bg-white text-dark border") px-2 py-1">
                                    @permit
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
        <button type="button" class="btn btn-dark px-4 fw-semibold rounded-2" data-bs-dismiss="modal">Close</button>
    </div>
}
else if (actionType == "delete")
{
    <!-- DELETE CONFIRMATION MODE -->
    <div class="px-2 text-center py-3">
        <div class="mb-3">
            <div class="mx-auto rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center fw-bold" style="width: 64px; height: 64px; font-size: 1.5rem;">
                <i class="bi bi-exclamation-triangle"></i> !
            </div>
        </div>
        <h5 class="fw-bold text-dark mb-2">Delete Officer Account?</h5>
        <p class="text-muted small mb-4 px-4">
            Are you sure you want to delete <strong class="text-dark">@Model.FullName</strong> (<span class="font-monospace">@@@Model.Username</span>)? This action is permanent and cannot be undone.
        </p>

        <div class="d-flex justify-content-center gap-2 pt-3 border-top">
            <button type="button" class="btn btn-light px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
            <a href="@Url.Action("DeleteUser", "Admin", new { id = Model.UserId })" class="btn btn-danger px-4 fw-semibold">Yes, Delete</a>
        </div>
    </div>
}
else
{
    <!-- CREATE OR EDIT FORM MODE -->
    using (Html.BeginForm(actionType == "create" ? "CreateUser" : "EditUser", "Admin", FormMethod.Post, new { id = "adminModalForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2 mb-3" })

        <div class="mb-3">
            @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter officer's full name", required = "required" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Username, "Username", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter username", required = "required" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        if (actionType == "create")
        {
            <div class="mb-3">
                @Html.LabelFor(m => m.PasswordHash, "Password", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
                @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter account password", required = "required" })
                @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        }
        else
        {
            <div class="mb-3">
                @Html.LabelFor(m => m.AccountStatus, "Account Status", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
                @Html.DropDownListFor(m => m.AccountStatus, new List<SelectListItem>
                {
                    new SelectListItem { Text = "Active", Value = "Active" },
                    new SelectListItem { Text = "Inactive", Value = "Inactive" }
                }, new { @class = "form-select form-select-lg fs-6" })
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                @Html.LabelFor(m => m.Email, "Email Address", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-lg fs-6", type = "email", placeholder = "Enter email address" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(m => m.PhoneNumber, "Phone Number", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
                @Html.TextBoxFor(m => m.PhoneNumber, new
                {
                    @class = "form-control form-control-lg fs-6",
                    type = "tel",
                    inputmode = "numeric",
                    pattern = @"\d*",
                    maxlength = "20",
                    placeholder = "Enter phone number",
                    oninput = "this.value = this.value.replace(/[^0-9]/g, '');"
                })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Birthdate, "Birthdate", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
            @Html.TextBoxFor(m => m.Birthdate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-lg fs-6", type = "date" })
            @Html.ValidationMessageFor(m => m.Birthdate, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="mb-4">
            @Html.LabelFor(m => m.HomeAddress, "Home Address", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
            @Html.TextBoxFor(m => m.HomeAddress, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter home address" })
            @Html.ValidationMessageFor(m => m.HomeAddress, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="button" class="btn btn-light px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-dark px-4 fw-semibold">Save Changes</button>
        </div>
    }
}