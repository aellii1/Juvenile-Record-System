@model User

@{
    string actionType = ViewBag.ActionType as string;

    // Helper logic for initials (used in details view)
    string initials = "U";
    if (!string.IsNullOrEmpty(Model?.FullName))
    {
        var nameParts = Model.FullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length >= 2)
        {
            initials = $"{nameParts[0][0]}{nameParts[nameParts.Length - 1][0]}".ToUpper();
        }
        else if (nameParts.Length == 1)
        {
            initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
        }
    }
}

@if (actionType == "details")
{
    <!-- DETAILS VIEW MODE -->
    <div class="px-2">
        <div class="d-flex align-items-center gap-3 pb-3 mb-3 border-bottom">
            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width: 56px; height: 56px; font-size: 1.25rem; letter-spacing: 0.5px;">
                @initials
            </div>
            <div>
                <h4 class="fw-bold text-dark mb-0 fs-5">@Model.FullName</h4>
                <span class="text-secondary font-monospace small">@@@Model.Username</span>
            </div>
        </div>

        <div class="row g-3 text-start">
            <div class="col-6">
                <span class="text-subtle small text-uppercase fw-semibold d-block mb-1">Officer ID</span>
                <span class="fw-bold text-dark">@Model.FormattedUserId</span>
            </div>
            <div class="col-6">
                <span class="text-subtle small text-uppercase fw-semibold d-block mb-1">Account Status</span>
                <div>
                    @if (Model.AccountStatus == "Active")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Inactive</span>
                    }
                </div>
            </div>
            <div class="col-12 pt-1">
                <span class="text-subtle small text-uppercase fw-semibold d-block mb-1">Registered Date</span>
                <span class="text-dark">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
        <button type="button" class="btn btn-dark px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
    </div>
}
else if (actionType == "delete")
{
    <!-- DELETE CONFIRMATION MODE -->
    <div class="px-2 text-center py-3">
        <div class="mb-3">
            <div class="mx-auto rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center fw-bold" style="width: 64px; height: 64px; font-size: 1.5rem;">
                <i class="bi bi-exclamation-triangle"></i> !
            </div>
        </div>
        <h5 class="fw-bold text-dark mb-2">Delete Officer Account?</h5>
        <p class="text-muted small mb-4 px-4">
            Are you sure you want to delete <strong class="text-dark">@Model.FullName</strong> (<span class="font-monospace">@@@Model.Username</span>)? This action is permanent and cannot be undone.
        </p>

        <div class="d-flex justify-content-center gap-2 pt-3 border-top">
            <button type="button" class="btn btn-light px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
            <a href="@Url.Action("DeleteUser", "Admin", new { id = Model.UserId })" class="btn btn-danger px-4 fw-semibold">Yes, Delete</a>
        </div>
    </div>
}
else
{
    <!-- CREATE OR EDIT FORM MODE -->
    using (Html.BeginForm(actionType == "create" ? "CreateUser" : "EditUser", "Admin", FormMethod.Post, new { id = "adminModalForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2 mb-3" })

        <div class="mb-3">
            @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter officer's full name", required = "required" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Username, "Username", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter username", required = "required" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        if (actionType == "create")
        {
            <div class="mb-4">
                @Html.LabelFor(m => m.PasswordHash, "Password", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
                @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control form-control-lg fs-6", placeholder = "Enter account password", required = "required" })
                @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        }
        else
        {
            <div class="mb-4">
                @Html.LabelFor(m => m.AccountStatus, "Account Status", new { @class = "form-label fw-semibold text-dark small text-uppercase" })
                @Html.DropDownListFor(m => m.AccountStatus, new List<SelectListItem>
                {
                    new SelectListItem { Text = "Active", Value = "Active" },
                    new SelectListItem { Text = "Inactive", Value = "Inactive" }
                }, new { @class = "form-select form-select-lg fs-6" })
            </div>
        }

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="button" class="btn btn-light px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-dark px-4 fw-semibold">Save Changes</button>
        </div>
    }
}

