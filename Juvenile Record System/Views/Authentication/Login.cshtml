@model Juvenile_Record_System.Models.Authentication

@{
    Layout = null; // Renders independently without layout headers/sidebars
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Juvenile Record System</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card border-0 shadow-sm p-4 rounded-3" style="width: 100%; max-width: 400px;">
        <div class="text-center mb-4">
            <h4 class="fw-bold text-dark mb-1">System Login</h4>
            <p class="text-muted small mb-0">Sign in to your officer account</p>
        </div>

        @using (Html.BeginForm("Login", "Authentication", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2 mb-3" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label fw-semibold small text-dark" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control shadow-none py-2", placeholder = "Enter username" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold small text-dark" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control shadow-none py-2", placeholder = "Enter password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-4 form-check">
                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input shadow-none" })
                @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label small text-muted" })
            </div>

            <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-2">Sign In</button>
        }
    </div>

</body>
</html>